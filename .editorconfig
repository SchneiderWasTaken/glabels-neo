# EditorConfig - https://editorconfig.org
# Mirrors .clang-format (spaces, IndentWidth 8, ColumnLimit 110).
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,hpp,h,c}]
indent_style = space
indent_size = 8
max_line_length = 110

[*.{yml,yaml,json,cmake}]
indent_style = space
indent_size = 2

[CMakeLists.txt]
indent_style = space
indent_size = 2

[*.{ui,qrc,svg,xml,ts}]
indent_style = space
indent_size = 1
trim_trailing_whitespace = false

[*.md]
trim_trailing_whitespace = false

[*.{sh,yml,yaml}]
end_of_line = lf

[*.{ps1,bat,cmd}]
end_of_line = crlf

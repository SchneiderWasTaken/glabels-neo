#ifndef update_UpdateConfig_hpp
#define update_UpdateConfig_hpp


#include <QString>


namespace glabels::update
{

        ///
        /// Build-time facts the self-updater needs.
        ///
        namespace Config
        {
                /// Release channel this build follows: "stable", "edge", or "" when the build
                /// was not produced by the release pipeline (self-update is then disabled).
                const QString CHANNEL = "@UPDATE_CHANNEL@";

                /// GitHub repository ("owner/name") that publishes the releases.
                const QString REPO = "@GLABELS_UPDATE_REPO@";

                /// Full commit hash this build was made from (identifies an "edge" build).
                const QString COMMIT = "@UPDATE_COMMIT@";

                /// Committer time of that commit (seconds since the epoch, 0 if unknown).  Edge releases are
                /// ordered by it, so a build is never offered an older one.
                const qint64 COMMIT_TIME = @UPDATE_COMMIT_TIME@;

                /// Release tag this build was made from, e.g. "v1.2.0" (identifies a "stable" build).
                const QString TAG = "@UPDATE_TAG@";
        }

}


#endif // update_UpdateConfig_hpp

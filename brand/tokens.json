{
  "$schema": "https://tr.designtokens.org/format/",
  "meta": {
    "brand": "gLabels Neo",
    "tagline": "A modernized fork of gLabels",
    "version": "1.0.0"
  },
  "brand": {
    "violet": "#7C3AED",
    "indigo": "#4F46E5",
    "blue": "#2563EB",
    "violetLight": "#A78BFA",
    "indigoLight": "#818CF8",
    "blueLight": "#60A5FA",
    "tintViolet": "#EDE9FE",
    "tintBlue": "#DBEAFE",
    "gradients": {
      "brand": {
        "angle": "135deg",
        "stops": [
          { "offset": "0%", "color": "#7C3AED" },
          { "offset": "50%", "color": "#4F46E5" },
          { "offset": "100%", "color": "#2563EB" }
        ],
        "css": "linear-gradient(135deg, #7C3AED 0%, #4F46E5 50%, #2563EB 100%)"
      },
      "brandLight": {
        "angle": "135deg",
        "stops": [
          { "offset": "0%", "color": "#A78BFA" },
          { "offset": "50%", "color": "#818CF8" },
          { "offset": "100%", "color": "#60A5FA" }
        ],
        "css": "linear-gradient(135deg, #A78BFA 0%, #818CF8 50%, #60A5FA 100%)"
      },
      "flap": {
        "angle": "135deg",
        "stops": [
          { "offset": "0%", "color": "#EDE9FE" },
          { "offset": "100%", "color": "#DBEAFE" }
        ],
        "css": "linear-gradient(135deg, #EDE9FE 0%, #DBEAFE 100%)"
      }
    }
  },
  "neutral": {
    "0": "#FFFFFF",
    "50": "#F8FAFC",
    "100": "#F1F5F9",
    "200": "#E2E8F0",
    "300": "#CBD5E1",
    "400": "#94A3B8",
    "500": "#64748B",
    "600": "#475569",
    "700": "#334155",
    "800": "#1E293B",
    "900": "#0F172A",
    "950": "#090D1A"
  },
  "status": {
    "success": {
      "base": "#059669",
      "textLight": "#047857",
      "textDark": "#34D399",
      "surfaceLight": "#ECFDF5",
      "surfaceDark": "#064E3B"
    },
    "warning": {
      "base": "#D97706",
      "textLight": "#B45309",
      "textDark": "#FBBF24",
      "surfaceLight": "#FFFBEB",
      "surfaceDark": "#78350F"
    },
    "danger": {
      "base": "#DC2626",
      "textLight": "#B91C1C",
      "textDark": "#F87171",
      "surfaceLight": "#FEF2F2",
      "surfaceDark": "#7F1D1D"
    }
  },
  "themes": {
    "light": {
      "surface": {
        "canvas": "#FFFFFF",
        "subtle": "#F8FAFC",
        "muted": "#F1F5F9",
        "elevated": "#FFFFFF",
        "inverse": "#090D1A"
      },
      "border": {
        "subtle": "#E2E8F0",
        "default": "#CBD5E1",
        "strong": "#94A3B8"
      },
      "text": {
        "primary": "#0F172A",
        "secondary": "#475569",
        "muted": "#64748B",
        "inverse": "#F8FAFC",
        "onBrand": "#FFFFFF",
        "accent": "#4F46E5"
      },
      "status": {
        "successText": "#047857",
        "successSurface": "#ECFDF5",
        "warningText": "#B45309",
        "warningSurface": "#FFFBEB",
        "dangerText": "#B91C1C",
        "dangerSurface": "#FEF2F2"
      }
    },
    "dark": {
      "surface": {
        "canvas": "#090D1A",
        "subtle": "#0F172A",
        "muted": "#1E293B",
        "elevated": "#0F172A",
        "inverse": "#F8FAFC"
      },
      "border": {
        "subtle": "#1E293B",
        "default": "#334155",
        "strong": "#475569"
      },
      "text": {
        "primary": "#F8FAFC",
        "secondary": "#CBD5E1",
        "muted": "#94A3B8",
        "inverse": "#0F172A",
        "onBrand": "#FFFFFF",
        "accent": "#A78BFA"
      },
      "status": {
        "successText": "#34D399",
        "successSurface": "#064E3B",
        "warningText": "#FBBF24",
        "warningSurface": "#78350F",
        "dangerText": "#F87171",
        "dangerSurface": "#7F1D1D"
      }
    }
  },
  "typography": {
    "fontSans": "'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif",
    "fontMono": "'JetBrains Mono', 'Cascadia Code', ui-monospace, monospace"
  },
  "radius": {
    "xs": "4px",
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "xl": "20px",
    "pill": "9999px"
  }
}
